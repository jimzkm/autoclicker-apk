#!/bin/sh
# Gradle wrapper launcher
# This script is generated by `gradle wrapper` on GitHub Actions.
# It is here as a placeholder. On GitHub Actions, the real wrapper
# script will be generated automatically.

DIST_GRADLE_VERSION=8.10.2

# If gradle-wrapper.jar exists, use it
WRAPPER_JAR="`dirname $0`/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
    exec java -cp "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi

# Otherwise, try to use system gradle
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

echo "ERROR: Neither gradle-wrapper.jar nor system gradle found."
echo "Please run 'gradle wrapper --gradle-version 8.10.2' first."
exit 1
